# Copy to .env and fill in (optional; server also reads OS env)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
SYSTEM_PROMPT=你是一个有帮助的助手。
LISTEN=:8080
DB_PATH=./data/clawmind.db
TOOLS_PATH=./config/tools.json
AGENT_WORKSPACE=

# 代码项目：仓库画像与改后自动验证
CLAWMIND_CODE_PROFILE=1
CLAWMIND_AUTO_VERIFY=1

# 自进化 harness（默认关闭）：Propose → Probe → Compose → Select → Reflect
CLAWMIND_EVOLUTION=0
CLAWMIND_EVOLUTION_K=3
CLAWMIND_EVOLUTION_MODE=parallel
CLAWMIND_HARNESS_DIR=./.clawmind/harness
# 真实执行证据：探针在 workdir 里跑推断出的测试命令（关闭时探针只做模型评估）
CLAWMIND_PROBE_EXEC=0
# 预算账本 R=4k / P=3k 与完成标记（runmark）：同一配置的重跑只复用已完成的运行
CLAWMIND_EVOLUTION_LEDGER=1
CLAWMIND_EVOLUTION_RESUME=1
# 首次为空 harness 写入软件工程 Skills 种子（工作流链 + 5 个优先技能 + preflight 脚本）
CLAWMIND_SEED_SKILLS=1

# 插件层：每个部件都是一个插件，按目录顺序组成有序层
CLAWMIND_PLUGIN_DIR=./.clawmind/plugins

# 记忆分层 L0→L3 与检索预算（条目数 / 字符数 / 超时）
CLAWMIND_MEMORY_BACKEND=sqlite
CLAWMIND_MEMORY_MAX_ITEMS=24
CLAWMIND_MEMORY_CHAR_BUDGET=2000
CLAWMIND_MEMORY_TIMEOUT_MS=3000
CLAWMIND_MEMORY_L0_CAP=400
CLAWMIND_MEMORY_L1_CAP=150
CLAWMIND_MEMORY_L2_CAP=100
CLAWMIND_MEMORY_L3_CAP=200
# 蒸馏（L0→L1→L2→L3）默认异步执行，不阻塞回复
CLAWMIND_MEMORY_DISTILL_ASYNC=1
# BM25 + 向量 + RRF：设置嵌入模型后启用向量分支，否则只做 BM25 + RRF
CLAWMIND_EMBEDDING_MODEL=

# 其他
CLAWMIND_TOKEN_BUDGET=0
CLAWMIND_MAX_CONTEXT_TOKENS=24000
