# Copy to .env and fill in (optional; server also reads OS env)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
SYSTEM_PROMPT=你是一个有帮助的助手。
LISTEN=:8080
DB_PATH=./data/clawmind.db
TOOLS_PATH=./config/tools.json
AGENT_WORKSPACE=

# 代码项目：仓库画像与改后自动验证
CLAWMIND_CODE_PROFILE=1
CLAWMIND_AUTO_VERIFY=1

# 自进化 harness（默认关闭）
CLAWMIND_EVOLUTION=0
CLAWMIND_EVOLUTION_K=3
CLAWMIND_EVOLUTION_MODE=parallel
CLAWMIND_HARNESS_DIR=./.clawmind/harness
